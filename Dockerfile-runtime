# Pin the distribution release so downstream application images keep a stable
# package repository across rebuilds.
FROM ubuntu:24.04

#############################
# Install tools
#############################

RUN apt-get update

# Update and install basic tools and Java (OpenJDK)
RUN apt-get install -y \
#    openjdk-21-jdk \
    curl \
    unzip \
    locales

#
# Set the locale to UTF-8
#

RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

#
# Java 25
#

ENV JRE_DOWNLOAD_URL=https://cdn.azul.com/zulu/bin/zulu25.36.205-ca-jre25.0.4.1-linux_x64.tar.gz

RUN curl --fail --retry 3 --output archive.tar.gz --location ${JRE_DOWNLOAD_URL} && \
	mkdir -p /opt/java/jdk && \
	tar -C /opt/java/jdk --strip 1 -xvzf archive.tar.gz && \
	rm archive.tar.gz

ENV JAVA_HOME=/opt/java/jdk
ENV JAVA_OPTS=-Xmx4g
ENV PATH=${JAVA_HOME}/bin:${PATH}
